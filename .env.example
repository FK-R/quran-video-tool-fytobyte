# --- Required ---
DATABASE_URL="postgresql://quran:quran@localhost:5432/quran?schema=public"

# --- Optional ---
STORAGE_DIR="./storage"        # uploads, overlays, renders (mount a volume here in production)
MAX_UPLOAD_MB=1500             # max background video size (<= 2047)
FFMPEG_PATH=                   # leave empty to use ffmpeg from PATH
FFPROBE_PATH=
FFMPEG_PRESET=veryfast         # x264 preset: ultrafast..veryslow
OVERLAY_CONCURRENCY=4          # parallel overlay renders
ARABIC_FONT="Amiri"            # must be installed on the host (Dockerfile installs it)
LATIN_FONT="Noto Sans"
